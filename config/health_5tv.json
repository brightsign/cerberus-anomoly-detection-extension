{
  "_comment": "5-TV health monitoring - BrightSign XT5 Extension Config",
  "device": {
    "camera_device": "rtsp://192.168.0.203:8554/live",
    "width": 1280,
    "height": 720,
    "fps": 10,
    "pixel_format": "YUYV"
  },
  "model": {
    "rknn_path": "model/mobilenetv2-embedding-@TARGET_SOC@.rknn",
    "input_w": 224,
    "input_h": 224,
    "embedding_dim": 1280
  },
  "reference": { "enabled": false },
  "roi": {
    "mode": "grid",
    "_comment": "2x3 grid = 6 tiles, count=5 uses first 5 as tv1..tv5. Grid works here because RTSP mosaic tiles fill each cell completely. For a physical camera, use rect mode to crop to the TV panel — grid 1x1 (full frame) fails when room background is visible.",
    "grid": { "rows": 2, "cols": 3, "count": 5, "order": "row_major" }
  },
  "anomaly": { "enabled": false },
  "health": {
    "enabled": true,
    "analysis_fps": 5,
    "dark_luma_threshold": 30,
    "black_enter_ratio": 0.95,
    "black_exit_ratio": 0.90,
    "black_var_enter": 300.0,
    "persist_black_ms": 1500,
    "persist_recover_ms": 1500,
    "off_mean": 6.0,
    "off_var": 30.0,
    "persist_off_ms": 2000,
    "osd_mode": "embedding_prototypes",
    "osd_prototypes_path": "/storage/sd/osd_prototypes.json",
    "osd_sim_min": 0.85,
    "tv_off_sim_min": 0.85,
    "osd_sim_min_no_signal": 0.80,
    "osd_sim_min_wrong_input": 0.85,
    "persist_osd_ms": 1500,
    "heartbeat_interval_ms": 10000,
    "prototype_capture": true,
    "prototype_labels": {
      "tv3": "NO_SIGNAL",
      "tv5": "INPUT_MENU"
    },
    "prototype_capture_seconds": 8,
    "prototype_output_path": "/storage/sd/osd_prototypes.json"
  },
  "mqtt": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 1883,
    "topic": "videowall/health",
    "client_id": "xt5-health-monitor"
  },
  "logging": {
    "level": "info",
    "path": "/var/log/anomaly_detection.log"
  }
}