#!/bin/bash

# BrightSign NPU Anomaly Detection - MobileNetV2 Model Compilation Script
# Compiles MobileNetV2 ONNX model to RKNN format using rknn_tk2 Docker container
# Uses Rockchip-validated MobileNetV2 from RKNN Model Zoo

set -e

# Check if running as root, which can cause permission issues.
if [ "$(id -u)" -eq 0 ]; then
    echo "Error: This script must not be run as root. Please run as a regular user."
    exit 1
fi

# get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Default values
PLATFORM=""
MODEL="mobilenetv2"
CLEAN=false
QUIET=false
VERBOSE=false
BUILD_CONTAINER=false

# Platform configurations
declare -A PLATFORMS=(
    ["XT5"]="rk3588"
    ["LS5"]="rk3568"
    ["Firebird"]="rk3576"
    ["RK3576"]="rk3576"
)

# Model configuration - MobileNetV2 (from RKNN Model Zoo)
declare -A MODEL_CONFIG=(
    ["mobilenetv2_name"]="mobilenetv2-12.onnx"
    ["mobilenetv2_output"]="mobilenetv2-12.rknn"
    ["mobilenetv2_dir"]="mobilenet"
)

MODEL_NAME="${MODEL_CONFIG[mobilenetv2_name]}"
OUTPUT_NAME="${MODEL_CONFIG[mobilenetv2_output]}"
MODEL_DIR="${MODEL_CONFIG[mobilenetv2_dir]}"

usage() {
    echo "Usage: $0 [OPTIONS] [PLATFORM]"
    echo "Compile MobileNetV2 model to RKNN format for BrightSign players"
    echo ""
    echo "Arguments:"
    echo "  PLATFORM            Target platform: XT5, LS5, Firebird (default: all)"
    echo ""
    echo "Options:"
    echo "  -c, --clean         Clean model directories before compilation"
    echo "  -q, --quiet         Use quieter build output"
    echo "  -v, --verbose       Enable verbose output"
    echo "  --build-container   Build rknn_tk2 Docker container first"
    echo "  -h, --help          Show this help message"
    echo ""
    echo "Examples:"
    echo "  $0                      # Compile MobileNetV2 for all platforms"
    echo "  $0 XT5                  # Compile MobileNetV2 for XT5/RK3588"
    echo "  $0 --clean              # Clean and compile for all platforms"
    echo "  $0 --build-container    # Build Docker container first"
    echo ""
    echo "Prerequisites:"
    echo "  1. Docker must be installed and running"
    echo "  2. RKNN Model Zoo cloned (auto-downloads mobilenetv2-12.onnx)"
    echo "  3. Calibration dataset must be prepared"
    echo ""
    echo "Platform mappings:"
    echo "  XT5      -> RK3588 (XT1145, XT2145 players)"
    echo "  LS5      -> RK3568 (LS445 players)"
    echo "  Firebird -> RK3576 (development boards)"
    echo "  RK3576   -> RK3576 (alternative name)"
    echo ""
    echo "Model:"
    echo "  MobileNetV2 (Rockchip-validated) - Embedding extraction"
    echo "  Input: 224x224x3 RGB"
    echo "  Output: 1280-dim embedding vector (before final classifier)"
    echo "  Source: RKNN Model Zoo mobilenet_v2 example"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -c|--clean)
            CLEAN=true
            shift
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        --build-container)
            BUILD_CONTAINER=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $1"
            usage
            exit 1
            ;;
        *)
            # Must be PLATFORM
            if [ -z "$PLATFORM" ]; then
                if [ -n "${PLATFORMS[$1]}" ]; then
                    PLATFORM="$1"
                    shift
                else
                    echo "Unknown platform: $1"
                    echo "Valid platforms: ${!PLATFORMS[@]}"
                    exit 1
                fi
            else
                echo "Too many arguments specified."
                usage
                exit 1
            fi
            ;;
    esac
done

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log() {
    if [ "$QUIET" != true ]; then
        echo -e "${BLUE}[COMPILE-MODELS] $1${NC}"
    fi
}

warn() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

error() {
    echo -e "${RED}❌ $1${NC}"
    exit 1
}

success() {
    echo -e "${GREEN}✅ $1${NC}"
}

# Check prerequisites
check_prerequisites() {
    log "Checking prerequisites..."
    
    # Check if Docker is available
    if ! command -v docker &> /dev/null; then
        error "Docker is required but not installed. Please install Docker first."
    fi
    
    # Check if Docker daemon is running
    if ! docker info &> /dev/null; then
        error "Docker daemon is not running. Please start Docker."
    fi
    
    # Check if toolkit directory exists
    if [ ! -d "toolkit" ]; then
        log "Creating toolkit directory..."
        mkdir -p toolkit
    fi
    
    # Check if RKNN Model Zoo is cloned
    if [ ! -d "toolkit/rknn-toolkit2" ]; then
        log "RKNN Toolkit 2 not found. Cloning..."
        cd toolkit
        git clone https://github.com/airockchip/rknn-toolkit2.git --depth 1 --branch v2.3.0 || \
            error "Failed to clone rknn-toolkit2"
        cd "${SCRIPT_DIR}"
    fi
    
    # Check if rknn_model_zoo is cloned
    if [ ! -d "toolkit/rknn_model_zoo" ]; then
        log "RKNN Model Zoo not found. Cloning..."
        cd toolkit
        git clone https://github.com/airockchip/rknn_model_zoo.git --depth 1 || \
            error "Failed to clone rknn_model_zoo"
        cd "${SCRIPT_DIR}"
    fi
    
    # Check if MobileNet example exists in Model Zoo
    # Note: RKNN Model Zoo uses "mobilenet" not "mobilenet_v2"
    if [ ! -d "toolkit/rknn_model_zoo/examples/mobilenet" ]; then
        error "MobileNet example not found in RKNN Model Zoo at toolkit/rknn_model_zoo/examples/mobilenet"
    fi
    
    # Check if ONNX model exists in Model Zoo
    local model_path="toolkit/rknn_model_zoo/examples/mobilenet/model/${MODEL_NAME}"
    if [ ! -f "$model_path" ]; then
        warn "MobileNetV2 ONNX model not found at: $model_path"
        echo ""
        echo "Downloading MobileNetV2 model from Model Zoo..."
        echo ""
        cd toolkit/rknn_model_zoo/examples/mobilenet/model
        if [ -f "download_model.sh" ]; then
            bash download_model.sh || error "Failed to download MobileNetV2 model"
        else
            # Try to download directly
            log "Attempting to download mobilenetv2-12.onnx..."
            wget https://github.com/onnx/models/raw/main/validated/vision/classification/mobilenet/model/mobilenetv2-12.onnx || \
                error "Failed to download ${MODEL_NAME}. Please download manually from https://github.com/onnx/models"
        fi
        cd "${SCRIPT_DIR}"
    fi
    
    # Check if calibration dataset exists; auto-generate synthetic one if missing
    if [ ! -f "toolkit/calibration_dataset.txt" ]; then
        warn "Calibration dataset not found at: toolkit/calibration_dataset.txt"
        echo ""
        echo "Auto-generating synthetic calibration dataset for testing..."
        echo "⚠️  NOTE: Synthetic images are for testing only."
        echo "   For production, replace with real video frames:"
        echo "   python3 tools/create_calibration_dataset.py --videos ref1.mp4 ref2.mp4"
        echo ""
        python3 "${SCRIPT_DIR}/tools/create_synthetic_calibration.py" || \
            error "Failed to create synthetic calibration dataset."
        echo ""
    fi
    
    success "Prerequisites check passed"
}

# Build rknn_tk2 Docker container
build_container() {
    log "Building rknn_tk2 Docker container..."
    
    # Check if Dockerfile exists
    if [ ! -f "toolkit/rknn-toolkit2/rknn-toolkit2/docker/docker_file/ubuntu_20_04_cp38/Dockerfile_ubuntu_20_04_for_cp38" ]; then
        error "Dockerfile not found. Please ensure toolkit is properly cloned."
    fi
    
    cd toolkit/rknn-toolkit2/rknn-toolkit2/docker/docker_file/ubuntu_20_04_cp38
    
    # Build the Docker container
    docker build --rm -t rknn_tk2 -f Dockerfile_ubuntu_20_04_for_cp38 . || error "Failed to build rknn_tk2 container"
    
    cd "${SCRIPT_DIR}"
    success "rknn_tk2 Docker container built successfully"
}

# Create conversion Python script
create_conversion_script() {
    local soc=$1
    local output_dir="toolkit/models/${soc^^}"
    
    mkdir -p "$output_dir"
    
    cat > "$output_dir/convert_mobilenetv2.py" << 'PYTHON_SCRIPT'
#!/usr/bin/env python3
"""
MobileNetV2 ONNX to RKNN Conversion Script
Extracts 1280-dim embedding (before final classification layer)
"""
import sys
from rknn.api import RKNN

def convert_model(onnx_path, target_platform, output_path, dataset_path):
    print(f"Converting MobileNetV2 for {target_platform}...")
    print("Extracting 1280-dim embedding layer (before classifier)")
    
    # Create RKNN object
    rknn = RKNN(verbose=True)
    
    # Configuration
    print('--> Config model')
    rknn.config(
        mean_values=[[123.675, 116.28, 103.53]],  # ImageNet mean (RGB)
        std_values=[[58.395, 57.12, 57.375]],     # ImageNet std (RGB)
        target_platform=target_platform,
        quantized_dtype='asymmetric_quantized-8',
        optimization_level=3,
        quantized_algorithm='normal',
        quantized_method='channel',
        # Specify output node to extract embedding before classifier
        # This will be the global average pooling output (1280-dim)
    )
    
    # Load ONNX model
    print('--> Loading ONNX model')
    ret = rknn.load_onnx(model=onnx_path)
    if ret != 0:
        print('Load ONNX model failed!')
        return False
    print('Done')
    
    # Build RKNN model with quantization
    print('--> Building RKNN model')
    ret = rknn.build(
        do_quantization=True,
        dataset=dataset_path
    )
    if ret != 0:
        print('Build RKNN model failed!')
        return False
    print('Done')
    
    # Export RKNN model
    print('--> Export RKNN model')
    ret = rknn.export_rknn(output_path)
    if ret != 0:
        print('Export RKNN model failed!')
        return False
    print('Done')
    
    # Accuracy analysis (optional)
    print('--> Init runtime environment')
    ret = rknn.init_runtime()
    if ret == 0:
        print('Runtime environment initialized successfully')
        print('--> MobileNetV2 ready for embedding extraction')
        print('    Expected output: 1280-dimensional feature vector')
    else:
        print('Warning: Could not initialize runtime for verification')
    
    # Release
    rknn.release()
    
    print(f'\nModel successfully converted to: {output_path}')
    print('Use this model to extract embeddings for reference matching')
    return True

if __name__ == '__main__':
    if len(sys.argv) != 5:
        print('Usage: python convert_mobilenetv2.py <onnx_path> <target_platform> <output_path> <dataset_path>')
        sys.exit(1)
    
    onnx_path = sys.argv[1]
    target_platform = sys.argv[2]
    output_path = sys.argv[3]
    dataset_path = sys.argv[4]
    
    success = convert_model(onnx_path, target_platform, output_path, dataset_path)
    sys.exit(0 if success else 1)
PYTHON_SCRIPT
    
    chmod +x "$output_dir/convert_mobilenetv2.py"
}

# Compile model for specific platform
compile_model() {
    local platform=$1
    local soc=${PLATFORMS[$platform]}
    local soc_upper=${soc^^}
    
    log "Compiling MobileNetV2 for $platform (SOC: $soc)..."
    
    # Create output directories
    mkdir -p "install/${soc_upper}/model"
    
    # Clean if requested
    if [ "$CLEAN" = true ]; then
        log "Cleaning MobileNetV2 model directory for ${soc_upper}..."
        rm -rf "install/${soc_upper}/model"/*
    fi
    
    # Create conversion script
    create_conversion_script "$soc"
    
    # Use Model Zoo's conversion script or custom one
    local model_zoo_path="toolkit/rknn_model_zoo/examples/mobilenet"
    local model_path="${model_zoo_path}/model/${MODEL_NAME}"
    
    # Run Docker compilation using custom script (Model Zoo convert.py may need adaptation)
    local docker_cmd="docker run -it --rm \
        -v ${SCRIPT_DIR}/toolkit:/workspace \
        rknn_tk2 \
        /bin/bash -c \"cd /workspace && \
        python /workspace/models/${soc_upper}/convert_mobilenetv2.py \
            /workspace/rknn_model_zoo/examples/mobilenet/model/${MODEL_NAME} \
            ${soc} \
            /workspace/models/${soc_upper}/${OUTPUT_NAME} \
            /workspace/calibration_dataset.txt\""
    
    if [ "$VERBOSE" = true ]; then
        log "Running Docker command: $docker_cmd"
    fi
    
    if [ "$QUIET" = true ]; then
        eval "$docker_cmd > /dev/null 2>&1" || error "Failed to compile MobileNetV2 for $platform"
    else
        eval "$docker_cmd" || error "Failed to compile MobileNetV2 for $platform"
    fi
    
    # Check if compilation succeeded and copy to install directory
    if [ -f "toolkit/models/${soc_upper}/${OUTPUT_NAME}" ]; then
        # Copy to install directory
        cp "toolkit/models/${soc_upper}/${OUTPUT_NAME}" "install/${soc_upper}/model/"
        log "Copied model to install/${soc_upper}/model/${OUTPUT_NAME}"
        
        success "MobileNetV2 compiled successfully for $platform"
        
        # Show model size
        local size=$(du -h "install/${soc_upper}/model/${OUTPUT_NAME}" | cut -f1)
        log "Model size: $size"
    else
        error "Compilation failed - ${OUTPUT_NAME} not found at toolkit/models/${soc_upper}/${OUTPUT_NAME}"
    fi
}

# Check if models are already compiled and installed
models_already_compiled() {
    for platform in "${!PLATFORMS[@]}"; do
        local soc=${PLATFORMS[$platform]}
        local soc_upper=${soc^^}
        local install_dir="${SCRIPT_DIR}/install/${soc_upper}/model"
        
        # Check if model exists in install directory
        if [ ! -f "$install_dir/${OUTPUT_NAME}" ]; then
            return 1  # Not all models compiled
        fi
    done
    return 0  # All models are compiled and installed
}

# Copy models to install directories
copy_models() {
    log "Verifying compiled models in install directories..."
    
    for platform in "${!PLATFORMS[@]}"; do
        local soc=${PLATFORMS[$platform]}
        local soc_upper=${soc^^}
        
        # Skip if model doesn't exist for this platform
        if [ ! -f "install/${soc_upper}/model/${OUTPUT_NAME}" ]; then
            continue
        fi
        
        log "Model ready: install/${soc_upper}/model/${OUTPUT_NAME}"
        
        # Create model config file
        cat > "install/${soc_upper}/model/mobilenetv2_config.json" << JSON
{
  "model_name": "MobileNetV2",
  "model_type": "embedding_extractor",
  "model_source": "RKNN Model Zoo (Rockchip-validated)",
  "input_size": [224, 224, 3],
  "input_format": "RGB",
  "mean": [123.675, 116.28, 103.53],
  "std": [58.395, 57.12, 57.375],
  "output_dims": 1280,
  "output_layer": "global_average_pooling",
  "quantization": "int8",
  "target_platform": "${soc}",
  "use_case": "Reference matching via cosine similarity on embedding vectors"
}
JSON
        
        log "Created model config: install/${soc_upper}/model/mobilenetv2_config.json"
    done
    
    success "Models verified in install directories"
}

# Main compilation function
main() {
    echo "BrightSign NPU Anomaly Detection - MobileNetV2 Model Compilation"
    echo "================================================================="
    echo "Using Rockchip-validated MobileNetV2 from RKNN Model Zoo"
    echo ""
    
    start_time=$(date +%s)
    
    # If --clean flag is set, clean models
    if [ "$CLEAN" = true ]; then
        log "Cleaning MobileNetV2 models from install/ and build/ directories..."
        
        # Clean from install directories
        for platform in "${!PLATFORMS[@]}"; do
            local soc=${PLATFORMS[$platform]}
            local soc_upper=${soc^^}
            local install_dir="install/${soc_upper}/model"
            if [ -f "$install_dir/${OUTPUT_NAME}" ]; then
                log "Removing $install_dir/${OUTPUT_NAME}..."
                rm -f "$install_dir/${OUTPUT_NAME}"
                rm -f "$install_dir/mobilenetv2_config.json"
            fi
        done
        
        # Clean from build directories
        local build_dirs=("build_xt5" "build_rk3576" "build_ls5" "build_firebird")
        for build_dir in "${build_dirs[@]}"; do
            if [ -f "$build_dir/model/${OUTPUT_NAME}" ]; then
                log "Removing $build_dir/model/${OUTPUT_NAME}..."
                rm -f "$build_dir/model/${OUTPUT_NAME}"
                rm -f "$build_dir/model/mobilenetv2_config.json"
            fi
        done
        
        # Clean toolkit build artifacts
        rm -rf toolkit/models/RK3588 toolkit/models/RK3568 toolkit/models/RK3576
        
        success "MobileNetV2 models cleaned successfully!"
        return 0
    fi
    
    # Check if models are already compiled and installed
    if models_already_compiled; then
        success "MobileNetV2 models already compiled and installed in install/ directory"
        echo ""
        echo "Installed models (Rockchip-validated):"
        for platform in "${!PLATFORMS[@]}"; do
            local soc=${PLATFORMS[$platform]}
            local soc_upper=${soc^^}
            local install_dir="install/${soc_upper}/model"
            
            if [ -f "$install_dir/${OUTPUT_NAME}" ]; then
                local size=$(du -h "$install_dir/${OUTPUT_NAME}" | cut -f1)
                echo "  $platform (${soc_upper}): ✓ ${OUTPUT_NAME} (${size})"
            fi
        done
        return 0
    fi
    
    check_prerequisites
    
    # Build container if requested
    if [ "$BUILD_CONTAINER" = true ]; then
        build_container
    fi
    
    # Check if rknn_tk2 container exists
    if ! docker images | grep -q "^rknn_tk2 "; then
        warn "rknn_tk2 Docker image not found. Building it now..."
        build_container
    fi
    
    # Determine which platforms to compile for
    if [ -n "$PLATFORM" ]; then
        log "Compiling MobileNetV2 for $PLATFORM..."
        compile_model "$PLATFORM"
    else
        log "Compiling MobileNetV2 for all platforms..."
        for platform in "${!PLATFORMS[@]}"; do
            compile_model "$platform"
            echo ""
        done
    fi
    
    # Copy models to install directories
    copy_models
    
    end_time=$(date +%s)
    duration=$((end_time - start_time))
    
    echo ""
    success "Model compilation completed in $(($duration / 60))m $(($duration % 60))s"
    
    echo ""
    echo "Compiled models (Rockchip-validated MobileNetV2):"
    for platform in "${!PLATFORMS[@]}"; do
        local soc=${PLATFORMS[$platform]}
        local soc_upper=${soc^^}
        local install_dir="install/${soc_upper}/model"
        
        if [ -f "$install_dir/${OUTPUT_NAME}" ]; then
            echo "  $platform (${soc_upper}):"
            echo "    ✓ MobileNetV2: $install_dir/${OUTPUT_NAME}"
            local size=$(du -h "$install_dir/${OUTPUT_NAME}" | cut -f1)
            echo "      Size: $size"
            echo "    ✓ Config: $install_dir/mobilenetv2_config.json"
            echo "    ✓ Output: 1280-dim embedding (before classifier)"
        fi
    done
    
    echo ""
    echo "Next steps:"
    echo "1. Build C++ application: ./build-apps"
    echo "2. Generate reference embeddings for video assets"
    echo "3. Test inference and alignment on target hardware"
    echo ""
    echo "Example workflow:"
    echo "  # Build reference timeline from source video"
    echo "  python tools/build_reference.py --video content.mp4 --fps 5 --output ref_embeddings.npy"
    echo ""
    echo "  # Build and deploy C++ app"
    echo "  ./build-apps XT5"
    echo ""
    echo "  # Run on XT5 with reference timeline"
    echo "  ./build_xt5/anomaly_detection --reference ref_embeddings.npy --camera 0"
}

# Run main function if script is executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
